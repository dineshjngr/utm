Options -Indexes -MultiViews
RewriteEngine On

# Force the canonical HTTPS, non-www hostname.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.utmcraft\.com$ [NC]
RewriteRule ^ https://utmcraft.com%{REQUEST_URI} [R=301,L]

# BEGIN GENERATED CANONICAL REDIRECTS
